include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md requirements*.txt
include Dockerfile compose.yaml .dockerignore
recursive-include briefing *.py *.json *.html *.js *.css
recursive-include deploy *.py *.sh *.service *.conf
recursive-include deploy/docker *.md *.example
recursive-include examples *.json
recursive-include cloud-gmail *.gs *.json
recursive-include scripts *.py
recursive-include qwen-skill *.md *.json
recursive-include skills *.md *.yaml
recursive-include docs *.md
recursive-include tests *.py *.cjs
recursive-include openspec *.md *.yaml
prune runtime
prune disposable
global-exclude __pycache__ *.py[cod] *.token *.pem *.key *.log
