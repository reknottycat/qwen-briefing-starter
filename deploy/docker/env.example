# Copy to the repository's ignored .env and set your own values.
# Never put API keys or role tokens here.
# Configure the Pi provider/model/API key in the authenticated HTTPS settings page.
# Role tokens remain protected files under runtime/credentials/.
# Set these to the Linux user that owns runtime/ (id -u / id -g).
BRIEFING_UID=1000
BRIEFING_GID=1000
BRIEFING_PORT=8787
# Set the exact peer IP of your HTTPS proxy after inspecting this Compose network.
# Host Nginx normally reaches the container from its Docker bridge gateway.
# Do not use * or an entire subnet. See deploy/docker/README.md.
BRIEFING_TRUSTED_PROXY_IPS=127.0.0.1
